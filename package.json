{
  "name": "clinuxflow-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "predeploy": "npm run build:kernel",
    "build:kernel": "npm run build:dictionary && npm run build:graphs-bundle && npm run build:system-forms && npm run build:system-flows",
    "fetch:packages": "node tools/fhir/fetch-packages.js",
    "build:dictionary": "node tools/fhir/fetch-packages.js && node tools/build-fhir-dictionary.js",
    "build:graphs-bundle": "node tools/build-graphs-bundle.js",
    "build:system-forms": "node tools/build-system-forms.js",
    "build:system-flows": "node tools/build-system-flows.js",
    "test": "vitest run"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-errors": "^3.0.0",
    "hono": "^4.6.0",
    "js-yaml": "^5.2.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "vitest": "^4.1.10",
    "wrangler": "^4.0.0"
  }
}
